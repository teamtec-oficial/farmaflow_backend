{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "server.ts",
    "prisma-client.ts",
    "notification-utils.ts",
    "prisma/**/*.ts",
    "tests/**/*.ts"
  ]
}
